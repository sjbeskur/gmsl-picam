# Startup defaults. iris set changes settings in memory; edit this file for persistence.
IRIS_TRANSMIT=tcp://127.0.0.1:9001
IRIS_CONTROL_BIND=0.0.0.0:8081
IRIS_CAMERA_INDEX=0
IRIS_WIDTH=1280
IRIS_HEIGHT=720
IRIS_FPS=30
IRIS_EXPOSURE_US=59000
IRIS_GAIN=1.5
IRIS_JPEG_QUALITY=85
IRIS_AUTO_EXPOSURE=false
IRIS_AUTO_GAIN=false
IRIS_IDLE=false
RUST_LOG=irisd=info,gmsl_picam_rs=info
